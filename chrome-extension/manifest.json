{
  "manifest_version": 3,
  "name": "Messiah TLV Apartment Hunter",
  "version": "0.7.0",
  "description": "סורק קבוצות דירות בפייסבוק, שולח התראות לטלגרם ומסנכרן לאפליקציית הדירות. קריאה בלבד.",
  "permissions": [
    "alarms",
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://facebook.com/*",
    "https://api.telegram.org/*",
    "https://api.github.com/*",
    "https://omerm14.github.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "pair.html",
  "action": {
    "default_title": "Messiah TLV Apartment Hunter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
